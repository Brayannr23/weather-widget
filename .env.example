# .env.example — SkyPulse
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control — add it to .gitignore.
#
# SkyPulse currently uses only public APIs with no key required.
# If you add a backend proxy to protect a paid API key, declare it here.

# Example for a future Node/Express backend proxy:
# WEATHER_API_KEY=your_api_key_here
# PORT=3000
# NODE_ENV=production
#
# The server would then read it with:
#   const apiKey = process.env.WEATHER_API_KEY;
# ...and NEVER expose it to the browser.
